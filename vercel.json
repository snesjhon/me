{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/resume",
      "destination": "/resume.pdf",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug*",
      "destination": "/",
      "permanent": true
    }
  ]
}
